diff --git a/src/compat.c b/src/compat.c
index 305fc1d..25d69e0 100644
--- a/src/compat.c
+++ b/src/compat.c
@@ -9,7 +9,11 @@
 #include <errno.h>
 #include <assert.h>
 #include <locale.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
 #include <langinfo.h>
+#endif
 
 /*
     Useful string stuff
@@ -199,7 +203,13 @@ void init_locale()
   {
 #ifdef HAVE_ICONV
     setlocale(LC_ALL, "");
+#ifdef _WIN32
+    /* no nl_langinfo on Windows: use the ANSI code page, which is what
+      command-line arguments and file names arrive in */
+    snprintf(default_charset_buf, sizeof default_charset_buf, "CP%u", GetACP());
+#else
     strncpy(default_charset_buf, nl_langinfo(CODESET), sizeof default_charset_buf - 1);
+#endif
     default_charset_buf[sizeof default_charset_buf - 1] = 0;
     default_charset = default_charset_buf;
     // fprintf(stderr, "INFO: default codeset is \"%s\"\n", default_charset); /* debug */
